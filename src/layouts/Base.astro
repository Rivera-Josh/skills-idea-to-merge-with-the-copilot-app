---
const { title = "Mona's Bookmark Manager App" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      /* Monaspace webfonts (GitHub Next, SIL OFL 1.1) self-hosted from /public/fonts.
         Neon carries body text; Xenon gives headings a touch of contrast.
         Self-hosting keeps the app fully offline-capable — no runtime CDN needed;
         the ui-monospace fallback still covers any load failure. */
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-700.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-700.woff2') format('woff2');
      }
      :root {
        color-scheme: light dark;
        --accent: #5368e8;
        --accent-soft: color-mix(in srgb, var(--accent) 13%, transparent);
        --border: color-mix(in srgb, currentColor 14%, transparent);
        --muted: color-mix(in srgb, currentColor 62%, transparent);
        --radius: 0.8rem;
        --font-body: 'Monaspace Neon', ui-monospace, 'SF Mono', 'Cascadia Code', monospace;
        --font-head: 'Monaspace Xenon', 'Monaspace Neon', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      body {
        font-family: var(--font-body);
        line-height: 1.5;
        max-width: 40rem;
        margin: 0 auto;
        min-height: 100vh;
        padding: 3.5rem 1.25rem 4rem;
        background:
          radial-gradient(ellipse at 12% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 28rem),
          Canvas;
      }
      header { margin-bottom: 2rem; }
      h1 { margin: 0 0 0.45rem; font-size: clamp(1.55rem, 6vw, 2rem); font-family: var(--font-head); letter-spacing: -0.035em; }
      .tagline { margin: 0; color: var(--muted); max-width: 36rem; }
      main {
        padding: clamp(1rem, 4vw, 1.5rem);
        border: 1px solid var(--border);
        border-radius: calc(var(--radius) + 0.3rem);
        background: color-mix(in srgb, Canvas 90%, var(--accent) 3%);
        box-shadow: 0 1.5rem 4rem color-mix(in srgb, currentColor 7%, transparent);
      }

      form {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: end;
        margin: 0 0 0.35rem;
      }
      .field { display: flex; flex-direction: column; gap: 0.45rem; flex: 1 1 16rem; }
      label { font-size: 0.85rem; font-weight: 600; }
      input {
        min-height: 2.9rem;
        padding: 0.65rem 0.8rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        font: inherit;
        background: color-mix(in srgb, Canvas 96%, var(--accent) 4%);
        color: inherit;
      }
      input:focus-visible,
      button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      button {
        min-height: 2.9rem;
        padding: 0.6rem 1rem;
        border: 1px solid transparent;
        border-radius: var(--radius);
        background: var(--accent);
        color: #fff;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      button:hover { filter: brightness(1.08); }
      .hint { margin: 0 0 0.9rem; font-size: 0.8rem; color: var(--muted); }
      .hint code { color: inherit; }
      .form-message {
        min-height: 1.25rem;
        margin: 0 0 1rem;
        color: var(--muted);
        font-size: 0.8rem;
      }

      #list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin: 1.5rem 0 0.75rem;
      }
      .list-title { margin: 0; font-size: 1rem; font-family: var(--font-head); }
      .clear {
        background: transparent;
        color: inherit;
        border: 1px solid var(--border);
        padding: 0.35rem 0.7rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .clear:hover { border-color: currentColor; }
      .search-field {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        margin: 1.5rem 0 0.75rem;
      }

      ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
      li.bookmark {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem 0.5rem;
        padding: 0.75rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: color-mix(in srgb, Canvas 94%, var(--accent) 4%);
      }
      .bookmark .url { flex: 1 1 12rem; min-width: 0; overflow-wrap: anywhere; color: inherit; text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent); text-underline-offset: 0.2em; }
      .bookmark .url:hover { color: var(--accent); }
      .bookmark .separator { white-space: pre; }
      .bookmark .slug {
        font-family: var(--font-body);
        font-size: 0.85rem;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        background: var(--accent-soft);
      }
      .bookmark .copy {
        background: transparent;
        color: inherit;
        border: 1px solid var(--border);
        padding: 0.3rem 0.6rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .empty {
        margin: 0;
        padding: 1.75rem 1rem;
        text-align: center;
        color: var(--muted);
        border: 1px dashed var(--border);
        border-radius: var(--radius);
      }

      footer { margin-top: 1.5rem; font-size: 0.8rem; color: var(--muted); text-align: center; }
      [hidden] { display: none !important; }

      @media (prefers-color-scheme: dark) {
        :root { --accent: #a3b1ff; }
        button:not(.clear):not(.copy) { color: #171a2b; }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
