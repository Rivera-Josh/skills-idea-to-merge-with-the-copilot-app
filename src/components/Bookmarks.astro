---
---
<form id="add-bookmark" novalidate>
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      aria-describedby="form-message"
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL with or without <code>https://</code> to create a short <code>mona-</code> slug.</p>
<p id="form-message" class="form-message" role="status" aria-live="polite"></p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="search-field" class="search-field" hidden>
  <label for="bookmark-search">Search saved bookmarks</label>
  <input id="bookmark-search" name="search" type="search" autocomplete="off" />
</div>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<p id="no-results" class="empty" hidden>No bookmarks match your search.</p>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
</ul>

<script>
  import {
    filterBookmarksByUrl,
    formatBookmark,
    generateSlug,
    loadBookmarks,
    normalizeUrl,
  } from '../lib/bookmarks.js';

  const storageKey = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const urlInput = document.getElementById('url');
  const searchField = document.getElementById('search-field');
  const searchInput = document.getElementById('bookmark-search');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const noResults = document.getElementById('no-results');
  const listHeader = document.getElementById('list-header');
  const message = document.getElementById('form-message');
  const clearButton = document.getElementById('clear-all');
  let bookmarks = [];

  function setMessage(text) {
    if (message) message.textContent = text;
  }

  function renderBookmarks() {
    if (!list || !emptyState || !noResults || !listHeader || !searchField) return;
    list.replaceChildren();
    const visibleBookmarks = filterBookmarksByUrl(bookmarks, searchInput?.value ?? '');
    visibleBookmarks.forEach((bookmark) => {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;
      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';
      item.append(link, separator);

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;
      item.append(slug);

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          setMessage(`Copied ${bookmark.slug}.`);
        } catch {
          setMessage('Could not copy the slug. Check clipboard permissions and try again.');
        }
      });
      item.append(copyButton);
      list.append(item);
    });

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    noResults.hidden = !hasBookmarks || visibleBookmarks.length > 0;
    listHeader.hidden = !hasBookmarks;
    searchField.hidden = !hasBookmarks;
  }

  function persistBookmarks(nextBookmarks) {
    try {
      window.localStorage.setItem(storageKey, JSON.stringify(nextBookmarks));
      return true;
    } catch {
      setMessage('Could not save bookmarks in this browser. Check storage permissions and try again.');
      return false;
    }
  }

  try {
    bookmarks = loadBookmarks(window.localStorage.getItem(storageKey));
  } catch {
    setMessage('Could not read bookmarks in this browser. Check storage permissions and try again.');
  }
  renderBookmarks();

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      const url = normalizeUrl(urlInput?.value ?? '');
      let slug = generateSlug();
      while (bookmarks.some((bookmark) => bookmark.slug === slug)) {
        slug = generateSlug();
      }
      const nextBookmarks = [...bookmarks, { url, slug }];
      if (!persistBookmarks(nextBookmarks)) return;
      bookmarks = nextBookmarks;
      renderBookmarks();
      form.reset();
      setMessage(`Saved ${formatBookmark(bookmarks[bookmarks.length - 1])}.`);
      urlInput?.focus();
    } catch (error) {
      setMessage(error instanceof Error ? error.message : 'Could not add this bookmark.');
    }
  });

  searchInput?.addEventListener('input', renderBookmarks);

  clearButton?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    try {
      window.localStorage.removeItem(storageKey);
      bookmarks = [];
      if (searchInput) searchInput.value = '';
      renderBookmarks();
      setMessage('All bookmarks cleared.');
    } catch {
      setMessage('Could not clear bookmarks in this browser. Check storage permissions and try again.');
    }
  });
</script>
